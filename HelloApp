/**
 * HelloApp UC5 - Display personalized greetings for multiple command-line arguments
 * or a default message when no arguments are provided.
 * 
 * Usage: java HelloApp [name1] [name2] ... [nameN]
 * 
 * @author Developer Name
 * @version 5.0
 * @since UC1
 */
public class HelloApp {
    public static void main(String[] args) {
        // Check if any names were provided
        if (args.length == 0) {
            // Default message when no arguments are provided
            System.out.println("Hello, World!");
        } else {
            // Build the greeting message using StringBuilder for efficiency
            StringBuilder nameBuilder = new StringBuilder();
            boolean first = true;
            
            // Enhanced for loop to iterate through all command-line arguments
            for (String name : args) {
                if (first) {
                    nameBuilder.append(name);
                    first = false;
                } else {
                    nameBuilder.append(", ").append(name);
                }
            }
            
            // Display the final greeting
            System.out.println("Hello, " + nameBuilder.toString() + "!");
        }
    }
}
